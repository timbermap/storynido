{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".env.local"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "lint": {},
    "typecheck": {},
    "test": {
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "@storynido/api#test": {
      "dependsOn": ["@storynido/firebase#test"],
      "outputs": []
    },
    "@storynido/worker#test": {
      "dependsOn": ["@storynido/api#test"],
      "outputs": []
    }
  }
}
