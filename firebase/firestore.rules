rules_version = '2';

// Reglas de Firestore de StoryNido.
// Principio: todo lo que no está permitido explícitamente está denegado.
// Precios, estados, costos, pedidos, fotos, consentimientos y auditoría los escribe
// solo el servidor (Admin SDK, que no pasa por estas reglas).
// Límites sincronizados con packages/shared/src/models (CHILD_LIMITS y otros).

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------- helpers

    function signedIn() {
      return request.auth != null;
    }

    function role() {
      return request.auth.token.get('role', 'customer');
    }

    function isAdmin() {
      return signedIn() && role() in ['admin', 'superadmin'];
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function ownsExisting() {
      return signedIn() && resource.data.ownerUid == request.auth.uid;
    }

    function ownsIncoming() {
      return signedIn() && request.resource.data.ownerUid == request.auth.uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function hasExactly(fields) {
      return incoming().keys().hasAll(fields) && incoming().keys().hasOnly(fields);
    }

    function changesOnly(fields) {
      return incoming().diff(resource.data).affectedKeys().hasOnly(fields);
    }

    function isNow(field) {
      return incoming()[field] == request.time;
    }

    function optString(value, max) {
      return value == null || (value is string && value.size() <= max);
    }

    function validLocale(value) {
      return value in ['es', 'en', 'pt'];
    }

    function validCountry(value) {
      return value in ['MX', 'US', 'ES', 'CO', 'CL', 'PE', 'BR'];
    }

    function activeOrAdmin() {
      return resource.data.active == true || isAdmin();
    }

    // ------------------------------------------------------------------ users

    function validUserProfile() {
      let d = incoming();
      return optString(d.displayName, 100)
        && optString(d.photoURL, 2048)
        && validLocale(d.locale)
        && validCountry(d.country)
        && d.marketingOptIn is bool;
    }

    match /users/{uid} {
      allow read: if isUser(uid) || isAdmin();

      // El perfil lo crea el propio usuario al primer inicio de sesión; `role` es solo servidor.
      allow create: if isUser(uid)
        && hasExactly(['email', 'displayName', 'photoURL', 'locale', 'country', 'marketingOptIn', 'createdAt', 'updatedAt'])
        && incoming().email == request.auth.token.get('email', null)
        && isNow('createdAt')
        && isNow('updatedAt')
        && validUserProfile();

      allow update: if isUser(uid)
        && changesOnly(['displayName', 'photoURL', 'locale', 'country', 'marketingOptIn', 'updatedAt'])
        && isNow('updatedAt')
        && validUserProfile();

      // El borrado de cuenta y datos pasa por la API (flujo de privacidad).
      allow delete: if false;
    }

    // --------------------------------------------------------------- children

    function validChild() {
      let d = incoming();
      return d.name is string && d.name.size() >= 1 && d.name.size() <= 40
        && d.age is int && d.age >= 0 && d.age <= 12
        && (d.pronouns == null || d.pronouns in ['she', 'he', 'they'])
        && d.likes is list && d.likes.size() <= 10
        && optString(d.petName, 40)
        && optString(d.bestFriendName, 40)
        && optString(d.get('alias', null), 40);
    }

    match /children/{childId} {
      allow read: if ownsExisting() || isAdmin();

      allow create: if ownsIncoming()
        // El alias es de Profesionales (los perfiles de Familias no lo tienen).
        && (hasExactly(['ownerUid', 'name', 'age', 'pronouns', 'likes', 'petName', 'bestFriendName', 'createdAt', 'updatedAt'])
          || hasExactly(['ownerUid', 'name', 'age', 'pronouns', 'likes', 'petName', 'bestFriendName', 'alias', 'createdAt', 'updatedAt']))
        && isNow('createdAt')
        && isNow('updatedAt')
        && validChild();

      allow update: if ownsExisting()
        && changesOnly(['name', 'age', 'pronouns', 'likes', 'petName', 'bestFriendName', 'alias', 'updatedAt'])
        && isNow('updatedAt')
        && validChild();

      allow delete: if ownsExisting();
    }

    // ------------------------------------------- photos y consents (servidor)

    match /photos/{photoId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    match /consents/{consentId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------------------------ books

    function ownsChild(childId) {
      return childId == null
        || (childId is string
          && get(/databases/$(database)/documents/children/$(childId)).data.ownerUid == request.auth.uid);
    }

    // Rasgos del modo sin foto (AVATAR_OPTIONS en packages/shared/src/models/character.ts).
    function validAvatar(a) {
      return a == null || (a is map
        && a.keys().hasOnly(['skinTone', 'hairColor', 'hairLength', 'hairType', 'eyeColor', 'glasses'])
        && a.skinTone in ['very-light', 'light', 'medium', 'tan', 'brown', 'deep']
        && a.hairColor in ['black', 'dark-brown', 'light-brown', 'blond', 'red']
        && a.hairLength in ['very-short', 'short', 'medium', 'long']
        && a.hairType in ['straight', 'wavy', 'curly', 'coily']
        && a.eyeColor in ['brown', 'hazel', 'green', 'blue', 'gray']
        && a.glasses is bool);
    }

    // Recuerdos guiados: todos opcionales, 150 caracteres como máximo.
    function validMemories(m) {
      return m == null || (m is map
        && m.keys().hasOnly(['moment', 'companion', 'nickname', 'favorite'])
        && optString(m.get('moment', null), 150)
        && optString(m.get('companion', null), 150)
        && optString(m.get('nickname', null), 150)
        && optString(m.get('favorite', null), 150));
    }

    // Eventos (fase 12b): cumpleaños con fecha, edad que cumple y temática (todo opcional).
    function validEvent(e) {
      return e == null || (e is map
        && e.keys().hasOnly(['type', 'date', 'turningAge', 'theme'])
        && e.type == 'birthday'
        && (e.get('date', null) == null
          || (e.date is string && e.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')))
        && (e.get('turningAge', null) == null
          || (e.turningAge is int && e.turningAge >= 1 && e.turningAge <= 15))
        && optString(e.get('theme', null), 60));
    }

    function validBookEdits() {
      let d = incoming();
      return (d.storyId == null || d.storyId is string)
        && (d.styleId == null || d.styleId is string)
        && d.lessonIds is list
        && d.lessonIds.size() + (d.customLesson == null ? 0 : 1) <= 2
        && optString(d.customLesson, 150)
        && validLocale(d.language)
        && optString(d.dedication, 500)
        && d.wizardStep is int && d.wizardStep >= 0 && d.wizardStep <= 10
        // Paso por nombre (DECISIONS 113); los borradores anteriores no lo tienen.
        && d.get('wizardStepKey', null) in [null, 'child', 'photos', 'story', 'memories', 'lesson', 'style', 'review']
        && d.photoIds is list && d.photoIds.size() <= 3
        // Los borradores anteriores al modo sin foto no tienen estos campos.
        && d.get('characterMode', 'photo') in ['photo', 'avatar']
        && validAvatar(d.get('avatar', null))
        && validMemories(d.get('memories', null))
        && validEvent(d.get('event', null))
        && optString(d.get('goal', null), 80)
        // Opciones editoriales (BOOK_LENGTHS, TEXT_DENSITIES, READING_LEVELS, CONTENT_TYPES).
        && d.get('length', null) in [null, 'mini', 'short', 'classic', 'epic']
        && d.get('textDensity', 'balanced') in ['visual', 'balanced', 'rich']
        && d.get('readingLevel', 'developing') in ['beginner', 'developing', 'advanced']
        && d.get('contentType', 'story') in ['story', 'coloring', 'activities', 'story_activities']
        && d.get('channel', 'families') in ['families', 'events', 'professionals']
        && ownsChild(d.childId);
    }

    match /books/{bookId} {
      allow read: if ownsExisting() || isAdmin();

      // Solo se crean borradores; preview, estado y regeneraciones los maneja el servidor.
      allow create: if ownsIncoming()
        && hasExactly(['ownerUid', 'status', 'childId', 'storyId', 'styleId', 'lessonIds', 'customLesson', 'language', 'dedication', 'wizardStep', 'photoIds', 'characterMode', 'avatar', 'memories', 'event', 'goal', 'length', 'textDensity', 'readingLevel', 'contentType', 'channel', 'preview', 'regenerationsUsed', 'createdAt', 'updatedAt'])
        && incoming().status == 'draft'
        && incoming().preview == null
        && incoming().regenerationsUsed == 0
        && isNow('createdAt')
        && isNow('updatedAt')
        && validBookEdits();

      allow update: if ownsExisting()
        && resource.data.status in ['draft', 'preview_ready']
        && changesOnly(['childId', 'storyId', 'styleId', 'lessonIds', 'customLesson', 'language', 'dedication', 'wizardStep', 'wizardStepKey', 'photoIds', 'characterMode', 'avatar', 'memories', 'event', 'goal', 'length', 'textDensity', 'readingLevel', 'contentType', 'updatedAt'])
        && isNow('updatedAt')
        && validBookEdits();

      allow delete: if ownsExisting() && resource.data.status == 'draft';

      // Controles de calidad del libro: solo el servidor escribe; el admin los consulta.
      match /qaEvents/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ----------------------------------------------------------------- orders

    match /orders/{orderId} {
      allow read: if ownsExisting() || isAdmin();
      allow write: if false;

      match /steps/{stepId} {
        allow read: if isAdmin()
          || (signedIn() && get(/databases/$(database)/documents/orders/$(orderId)).data.ownerUid == request.auth.uid);
        allow write: if false;

        // Tareas por página de las ilustraciones: internas del pipeline.
        match /pages/{index} {
          allow read: if isAdmin();
          allow write: if false;
        }
      }

      // Eventos del pipeline ya procesados (deduplicación): solo el worker.
      match /events/{requestId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Avisos para el admin (pipeline trabado, pasos agotados): los escribe el worker.
    match /adminAlerts/{alertId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Cotizaciones de impresos (Eventos): las escribe la API; las atiende el equipo.
    match /printQuoteRequests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Opiniones: las escribe la API (dueño del pedido); publicarlas es una decisión manual.
    match /reviews/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Registro de mails (con direcciones): solo el admin lo lee; lo escribe el servidor.
    match /emailLog/{emailId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------- catálogo y configuración

    match /stories/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /lessons/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /illustrationStyles/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /products/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /countries/{code} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    // Matriz de impresión: la usa la API; el admin la consulta (se edita en la fase 14).
    match /printOptions/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /prices/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    // Márgenes por producto (DECISIONS 096): los lee la API; el público ve solo el precio final.
    match /productPricing/{product} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /proDiscounts/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /eventPricing/{country} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /promotions/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /content/{id} {
      allow read: if resource.data.published == true || isAdmin();
      allow write: if false;
    }

    match /siteConfig/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /coupons/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /collections/{id} {
      allow read: if activeOrAdmin();
      allow write: if false;
    }

    match /editorialConfig/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /activityTemplates/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /aiConfig/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /auditLog/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // ------------------------------------------------ costos y cuotas de IA

    // Uso y gasto de IA: solo el servidor escribe; el admin lo consulta.
    // Catálogo de modelos, métricas y tipos de cambio: los escribe el servidor; el admin los lee.
    match /aiModels/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /metricsDaily/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /fxRates/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /privacyRequests/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiUsage/{id} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /aiBudget/{day} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Contadores anti abuso (por usuario y por hash de IP): nadie los lee desde el cliente.
    match /previewQuota/{id} {
      allow read, write: if false;
    }
  }
}
