{
  "firestore": {
    "rules": "firebase/firestore.rules",
    "indexes": "firebase/firestore.indexes.json"
  },
  "storage": {
    "rules": "firebase/storage.rules"
  },
  "emulators": {
    "singleProjectMode": true,
    "auth": {
      "host": "127.0.0.1",
      "port": 9099
    },
    "firestore": {
      "host": "127.0.0.1",
      "port": 8180
    },
    "storage": {
      "host": "127.0.0.1",
      "port": 9199
    },
    "pubsub": {
      "host": "127.0.0.1",
      "port": 8085
    },
    "ui": {
      "enabled": true,
      "host": "127.0.0.1",
      "port": 4000
    },
    "hub": {
      "host": "127.0.0.1",
      "port": 4400
    },
    "logging": {
      "host": "127.0.0.1",
      "port": 4500
    }
  },
  "apphosting": [
    {
      "backendId": "web",
      "rootDir": "apps/web",
      "ignore": [
        ".git",
        "**/node_modules",
        "**/.next",
        "**/.turbo",
        "**/dist",
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*",
        "firebase-debug.log",
        "**/*.log",
        "eval-reports",
        "infra",
        "coverage",
        "**/*.tfstate*",
        "**/tfplan"
      ]
    },
    {
      "backendId": "admin",
      "rootDir": "apps/admin",
      "ignore": [
        ".git",
        "**/node_modules",
        "**/.next",
        "**/.turbo",
        "**/dist",
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*",
        "firebase-debug.log",
        "**/*.log",
        "eval-reports",
        "infra",
        "coverage",
        "**/*.tfstate*",
        "**/tfplan"
      ]
    }
  ]
}
