# =============================================================================
# StoryNido · variables de entorno
#
# Copiá este archivo a `.env.local` en la RAÍZ del repo y completá los valores:
#   cp .env.example .env.local
#
# - `.env.local` está en .gitignore: NUNCA se sube al repo.
# - Este archivo (.env.example) SÍ se sube: solo nombres y valores de ejemplo, jamás claves reales.
# - Todas las apps y servicios leen este único `.env.local`.
# - En staging/producción NO se usan archivos: los secretos (marcados [SECRETO])
#   viven en Google Secret Manager y se inyectan como variables de entorno.
# - Las variables NEXT_PUBLIC_* se envían al navegador: nunca pongas un secreto ahí.
# - Con los proveedores en `mock` todo funciona en local sin ninguna clave.
# =============================================================================

# --- Marca --------------------------------------------------------------------
BRAND_NAME=StoryNido
NEXT_PUBLIC_BRAND_NAME=StoryNido
BRAND_DOMAIN=storynido.com
NEXT_PUBLIC_BRAND_DOMAIN=storynido.com

# --- Servicios locales ----------------------------------------------------------
# Puertos: api 8080, worker 8081 (definidos en cada servicio).
LOG_LEVEL=debug

# --- Google Cloud / Firebase (fase 02-03) ---------------------------------------
# Autenticación local con Google Cloud: `gcloud auth application-default login`.
# No se usan archivos JSON de cuentas de servicio.
GCP_PROJECT_ID=
GCP_REGION=us-central1

# Emuladores locales (pnpm emulators). Proyecto demo-*: nunca toca Google Cloud.
NEXT_PUBLIC_USE_FIREBASE_EMULATORS=true
FIRESTORE_EMULATOR_HOST=127.0.0.1:8180
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_STORAGE_EMULATOR_HOST=127.0.0.1:9199
PUBSUB_EMULATOR_HOST=127.0.0.1:8085

# Configuración web de Firebase (pública por diseño, la protegen las reglas y App Check).
# Con emuladores alcanzan estos valores demo. Para staging: terraform output firebase_web_config.
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=demo-storynido.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=demo-storynido
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# --- IA (fase 07) -------------------------------------------------------------
# Proveedores: mock | vertex | anthropic | flux
AI_TEXT_PROVIDER=mock
AI_IMAGE_PROVIDER=mock
VERTEX_LOCATION=us-central1
# [SECRETO] Solo si se usa Claude para texto
ANTHROPIC_API_KEY=
# [SECRETO] Solo si se usa Flux para imágenes
FLUX_API_KEY=

# --- Pagos (fase 11) ------------------------------------------------------------
# Proveedores: mock | stripe
PAYMENT_PROVIDER=mock
# [SECRETO] sk_test_... en local y staging, sk_live_... solo en producción
STRIPE_SECRET_KEY=
# [SECRETO] whsec_... (en local lo da `stripe listen`)
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# --- Impresión (fase 12) --------------------------------------------------------
# Proveedores: mock | gelato
PRINT_PROVIDER=mock
# [SECRETO]
GELATO_API_KEY=
# [SECRETO]
GELATO_WEBHOOK_SECRET=

# --- Emails (fase 13) -----------------------------------------------------------
# Proveedores: mock | resend
EMAIL_PROVIDER=mock
# [SECRETO]
RESEND_API_KEY=
EMAIL_FROM=StoryNido <hola@storynido.com>

# --- Analítica (fase 05 y 11) ---------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=
NEXT_PUBLIC_META_PIXEL_ID=
# [SECRETO] API de Conversiones de Meta
META_CAPI_ACCESS_TOKEN=
